{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug timsync sync",
            "cargo": {
                "args": [
                    "build",
                    "--bin=timsync",
                    "--package=timsync"
                ],
                "filter": {
                    "name": "timsync",
                    "kind": "bin"
                }
            },
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "args": [
                "sync"
            ],
            "cwd": "${workspaceFolder}/example"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug timsync sync (en-US)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=timsync",
                    "--package=timsync"
                ],
                "filter": {
                    "name": "timsync",
                    "kind": "bin"
                }
            },
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "args": [
                "sync",
                "--language",
                "en-US"
            ],
            "cwd": "${workspaceFolder}/example"
        }
    ]
}